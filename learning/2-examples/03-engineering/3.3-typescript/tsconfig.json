{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": false,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
