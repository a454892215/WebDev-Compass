{
  "name": "@compass/stage4-react-elective",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "vite --host 127.0.0.1 --port 4304 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4305 --strictPort",
    "verify:browser": "node verify-browser.mjs",
    "verify:artifacts": "node verify-artifacts.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zustand": "5.1.0",
    "@reduxjs/toolkit": "2.15.0",
    "@tanstack/react-query": "5.108.4",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "jsdom": "31.0.1",
    "@playwright/test": "1.65.1"
  }
}
