{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "vue",
        "@vue/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "vue-runtime"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "migration-review"
      ],
      "automerge": false
    }
  ]
}
