{
  "name": "@compass/stage12-storybook-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=true storybook dev --host 127.0.0.1 -p 4544 --ci --no-open",
    "build": "pnpm tokens && STORYBOOK_DISABLE_TELEMETRY=true storybook build --disable-telemetry -o dist/storybook",
    "test": "node --test tests/*.test.mjs",
    "verify": "node verify.mjs",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext tests/token-types.ts"
  },
  "dependencies": {
    "vue": "3.5.46"
  },
  "devDependencies": {
    "storybook": "10.6.9",
    "@storybook/vue3-vite": "10.6.9",
    "style-dictionary": "5.8.0",
    "vite": "8.3.8",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1"
  }
}
