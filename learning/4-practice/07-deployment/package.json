{
  "name": "@compass/stage7-deployment",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1 --port 4507",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "node scripts/build-profile.mjs ssr",
    "preview": "node artifacts/ssr/server/index.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "build:ssg": "node scripts/build-profile.mjs ssg",
    "build:csr": "node scripts/build-profile.mjs csr",
    "test:profiles": "node scripts/verify-profiles.mjs"
  },
  "dependencies": {
    "nuxt": "4.7.0",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.7.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "vitest": "5.1.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.1"
  }
}
