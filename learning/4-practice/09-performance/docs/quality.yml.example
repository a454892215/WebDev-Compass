# Local teaching template, not placed in .github/workflows or run remotely.
name: stage9-quality-example
on: [workflow_dispatch]
permissions:
  contents: read
jobs:
  quality:
    runs-on: ubuntu-24.04
    defaults:
      run:
        working-directory: learning/4-practice/09-performance
    steps:
      # Official checkout v6 SHA verified in stage7; review updates before adoption.
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          persist-credentials: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: 26.0.0
      - run: npm install --global pnpm@11.4.0
      - run: pnpm install --frozen-lockfile
      # build precedes the real byte budget; nonzero fails the job.
      - run: pnpm check
# Browser dependencies/runner and LHCI remain explicit later work, not faked here.
