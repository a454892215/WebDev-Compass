{
  "name": "@compass/stage12-component-host",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1 --port 4541",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "pnpm build:ui && nuxt build",
    "preview": "node .output/server/index.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm build:ui && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm verify:package && pnpm verify:changesets && pnpm build",
    "build:ui": "vite build --config lib/vite.config.ts && vue-tsc -p lib/tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:changesets": "node scripts/verify-changesets.mjs",
    "check:ci": "pnpm check && pnpm test:e2e"
  },
  "dependencies": {
    "@compass/stage12-ui": "workspace:*",
    "nuxt": "4.7.0",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.7.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
